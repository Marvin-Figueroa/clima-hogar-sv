---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Página no encontrada — Clima Hogar SV"
  description="La página que buscas no existe o fue movida."
  robots="noindex, nofollow"
>
  <Header />
  <main class="flex min-h-screen flex-col items-center justify-center bg-bone px-6 py-32">
    <div class="relative mx-auto w-full max-w-lg text-center">
      <p class="font-display text-7xl font-extrabold text-navy lg:text-8xl">404</p>

      <h1 class="mt-6 font-display text-3xl font-bold leading-tight text-navy lg:text-4xl">
        Página no encontrada
      </h1>

      <div class="mx-auto mt-5 flex items-center justify-center gap-3">
        <div class="h-0.5 w-12 rounded-full bg-cyan"></div>
        <div class="h-0.5 w-4 rounded-full bg-blue/40"></div>
      </div>

      <p class="mt-6 font-body text-lg leading-relaxed text-gray-600">
        El enlace que abriste no existe o fue movido. Puedes volver al inicio o escribirnos
        directamente.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-full bg-navy px-7 py-3.5 font-display text-sm font-bold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-navy-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
        >
          Volver al inicio
        </a>
        <a
          href="https://wa.me/50379723918"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full border border-navy/20 px-7 py-3.5 font-display text-sm font-semibold text-navy transition-all duration-300 hover:-translate-y-0.5 hover:border-navy/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
        >
          Escríbenos por WhatsApp
          <span class="sr-only">(abre en nueva pestaña)</span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
